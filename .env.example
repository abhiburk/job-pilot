# Copy to .env and fill in. Never commit .env.

APP_NAME=JobPilot
# "local" for development. Any other value (e.g. "production") turns on
# Secure cookies, HSTS, SMTP certificate validation and hides /docs.
APP_ENV=local
DEBUG=true
# Logs every SQL statement with parameters (includes password/session hashes).
SQL_ECHO=false

DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379/0
# Only used by the test suite; must end in /jobpilot_test.
TEST_DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot_test

# --- Authentication ---
# Set to false after creating your account on a public deployment.
REGISTRATION_ENABLED=true
SESSION_TTL_HOURS=168
# Leave unset to derive from APP_ENV (Secure everywhere except local).
# SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
PASSWORD_RESET_TTL_MINUTES=60
# Browser origins allowed to call the API (comma-separated, exact match).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public frontend URL used in password-reset emails.
FRONTEND_URL=http://localhost:5173

# --- AI providers ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Email (digests and password reset) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=jobpilot@example.com
SMTP_FROM_NAME=JobPilot
SMTP_USE_TLS=false
SMTP_START_TLS=true
# Leave unset to derive from APP_ENV (validate everywhere except local).
# SMTP_VALIDATE_CERTS=true

# Job source keys to switch off (comma-separated): jobicy, freehire, remotive
JOB_SOURCES_DISABLED=

JOB_DIGEST_MIN_SCORE=70
JOB_DIGEST_MAX_JOBS=10
JOB_DIGEST_TIMEZONE=Asia/Kolkata
JOB_DIGEST_MIN_COVERAGE=60
